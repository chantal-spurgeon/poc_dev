USE ROLE ACCOUNTADMIN;
ALTER ACCOUNT SET DISABLE_UI_DOWNLOAD_BUTTON = TRUE;

# Main reason to disable is to force users to use COPY INTO which is logged.
# Users with only RO access in the account cannot create stages, thus cannot download data

USE ROLE ACCOUNTADMIN;
ALTER ACCOUNT SET REQUIRE_STORAGE_INTEGRATION_FOR_STAGE_CREATION = TRUE;
ALTER ACCOUNT SET REQUIRE_STORAGE_INTEGRATION_FOR_STAGE_OPERATION = TRUE;

# Forces the use of integrations for external stages.
# Users would then have to have USAGE on integration for stages to work.

USE ROLE ACCOUNTADMIN;
ALTER ACCOUNT SET PREVENT_UNLOAD_TO_INTERNAL_STAGES = TRUE;

# Prevents data unload operations to any internal stage, including user stages,
# table stages, or named internal stages.

ALTER USER <user> PREVENT_UNLOAD_TO_INLINE_URL = TRUE;

# Prevents ad hoc data unload operations to external cloud storage locations
# (i.e. COPY INTO <location> statements that specify the cloud storage URL and
# access settings directly in the statement).

# Row access policy
# https://docs.snowflake.com/en/user-guide/security-row-intro

# Identify policies
SELECT *
FROM TABLE(
  mydb.INFORMATION_SCHEMA.POLICY_REFERENCES(
 POLICY_NAME=>'mydb.policies.rap1'
  )
);

# Examples

-- table
CREATE TABLE sales (
  customer   varchar,
  product    varchar,
  spend      decimal(20, 2),
  sale_date  date,
  region     varchar
)
WITH ROW ACCESS POLICY sales_policy ON (region);

-- view
CREATE VIEW sales_v WITH ROW ACCESS POLICY sales_policy ON (region)
AS SELECT * FROM sales;

CREATE TABLE security.salesmanagerregions (
  sales_manager varchar,
  region        varchar
);

USE ROLE SECURITYADMIN;

CREATE ROLE mapping_role;

GRANT SELECT ON TABLE security.salesmanagerregions TO ROLE mapping_role;

USE ROLE schema_owner_role;

CREATE OR REPLACE ROW ACCESS POLICY security.sales_policy
AS (sales_region varchar) RETURNS BOOLEAN ->
  'sales_executive_role' = CURRENT_ROLE()
 OR EXISTS (
   SELECT 1 FROM salesmanagerregions
     WHERE sales_manager = CURRENT_ROLE()
     AND region = sales_region
 )
;

GRANT OWNERSHIP ON ROW ACCESS POLICY security.sales_policy TO mapping_role;

GRANT APPLY ON ROW ACCESS POLICY security.sales_policy TO ROLE sales_analyst_role;

USE ROLE SECURITYADMIN;

ALTER TABLE sales ADD ROW ACCESS POLICY security.sales_policy ON (region);

GRANT SELECT ON TABLE sales TO ROLE sales_manager_role;

USE ROLE sales_manager_role;
SELECT product, SUM(spend)
FROM sales
WHERE YEAR(sale_date) = 2020
GROUP BY product;

-- 1. Create the row access policy
CREATE OR REPLACE ROW ACCESS POLICY region_access_policy
    AS (policy_region_id INT) RETURNS BOOLEAN ->
       (CURRENT_ROLE() = 'DATA_ANALYST_EMEA_ROLE' AND policy_region_id = 1)
    OR (CURRENT_ROLE() = 'DATA_ANALYST_APAC_ROLE' AND policy_region_id = 2)
    OR (CURRENT_ROLE() = 'DATA_ANALYST_NA_ROLE'   AND policy_region_id = 3)
    OR (CURRENT_ROLE() = 'DATA_ANALYST_LATAM_ROLE' AND policy_region_id = 4)
    OR (CURRENT_ROLE() IN ('ACCOUNTADMIN', 'SECURITYADMIN')) -- Allow admins full visibility
;

-- 2. Apply the policy to your specific table
ALTER TABLE your_table_name 
    ADD ROW ACCESS POLICY region_access_policy ON (region_id);

