# Right-sizing

# Queries slow and spilling to disk ->
# not enough memory per query -> scale UP to a bigger size.

# Queries waiting in a queue before starting ->
# not enough slots for concurrent work -> scale OUT to more clusters.

# A bigger warehouse gives each query more memory.
# It does almost nothing for how many can run at once.
# What you actually want is MAX_CLUSTER_COUNT above 1,
# so Snowflake adds clusters under load and suspends them after
# You pay for that capacity only while it's in use.

# REMEMBER for ingestion:
# Split files into smaller files 100-250 MB size.
# Multiple threads are more efficient - smaller files can be processed in parallel.
# Node = 8 threads. XS is 2 nodes

# Queued Load (AVG_QUEUED_LOAD): Values greater than 0 mean queries are waiting for free compute resources because active queries have reached the concurrency limit.
# High Running Load (AVG_RUNNING): Shows the average number of queries actively running during the time slice.
# Queued Overload Time: Individual queries spend time waiting in the queue before execution
# https://docs.snowflake.com/en/user-guide/warehouses-load-monitoring

SELECT * 
FROM TABLE(information_schema.warehouse_load_history(
    DATE_RANGE_START => DATEADD('hour', -24, CURRENT_TIMESTAMP()),
    WAREHOUSE_NAME => 'YOUR_WAREHOUSE_NAME'
));

SELECT start_time, query_text, queued_overload_time, execution_time 
FROM snowflake.account_usage.query_history 
WHERE start_time >= DATEADD('day', -7, CURRENT_DATE())
  AND warehouse_name = 'YOUR_WAREHOUSE_NAME'
  AND queued_overload_time > 0;

