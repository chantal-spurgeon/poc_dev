# AWS Secrets Manager provides a dedicated managed schema for Snowflake integrations.
# Create a Key/Value secret containing the following exact JSON

{
  "account": "xy12345.us-east-1",
  "user": "your_snowflake_username",
  "privateKey": "-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG...[Use \n for line breaks]...\n-----END PRIVATE KEY-----",
  "publicKey": "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0B...[Use \n for line breaks]...\n-----END PUBLIC KEY-----",
  "passphrase": "your_optional_passphrase"
}

# account: Your Snowflake account identifier (the string preceding .snowflakecomputing.com in your login URL).
# privateKey / publicKey: The entire raw text contents of your key files. Keep the header/footer
# markers if using this template. Replace literal line breaks with \n to keep the JSON string valid.

# Python implementation example

import json
import boto3
from snowflake import connector
from cryptography.hazmat.primitives import serialization
from cryptography.hazmat.backends import default_backend

def get_snowflake_connection():
    # 1. Retrieve the config payload from AWS Secrets Manager
    secret_name = "your/aws/secret/name"
    region_name = "us-east-1"

    client = boto3.client("secretsmanager", region_name=region_name)
    response = client.get_secret_value(SecretId=secret_name)

    # Parse your specific JSON payload structure
    config = json.loads(response["SecretString"])

    sf_account = config["account"]
    sf_user = config["user"]
    private_key_str = config["privateKey"]
    passphrase_str = config["passphrase"]

    # 2. Convert text fields to bytes
    private_key_bytes = private_key_str.encode('utf-8')
    passphrase_bytes = passphrase_str.encode('utf-8') if passphrase_str else None

    # 3. Deserialize and decrypt the PEM key
    p_key = serialization.load_pem_private_key(
        private_key_bytes,
        password=passphrase_bytes,  # Automatically handles None if unencrypted
        backend=default_backend()
    )

    # 4. Convert the private key into the DER bytes required by Snowflake
    pkb = p_key.private_bytes(
        encoding=serialization.Encoding.DER,
        format=serialization.PrivateFormat.PKCS8,
        encryption_algorithm=serialization.NoEncryption()
    )

    # 5. Connect to Snowflake using the secret's connection values
    ctx = connector.connect(
        user=sf_user,
        account=sf_account,
        private_key=pkb,
        warehouse='your_warehouse', # Pass these if needed, or set defaults in Snowflake
        database='your_database',
        schema='your_schema'
    )

    return ctx


